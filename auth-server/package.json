{
  "name": "auth-server",
  "version": "0.0.1",
  "description": "Production-reference authentication server with JWT, refresh token rotation, and multi-database support",
  "author": "George",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.22.1 <25.0.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "build": "node ../tools/compile.mjs build",
    "start": "pnpm build && node --enable-source-maps dist/main.js",
    "start:dev": "node --watch-path=src --watch-path=tsconfig.json --watch-path=tsconfig.build.json --watch-path=../tools --watch-preserve-output ../tools/watch.mjs app",
    "start:debug": "node --watch-path=src --watch-path=tsconfig.json --watch-path=tsconfig.build.json --watch-path=../tools --watch-preserve-output ../tools/watch.mjs debug",
    "start:prod": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json",
    "test:watch": "node --watch-path=src --watch-path=test --watch-path=tsconfig.json --watch-path=tsconfig.test.json --watch-path=../tools --watch-preserve-output ../tools/watch.mjs tests",
    "test:cov": "pnpm test --coverage",
    "test:debug": "pnpm test:compile && node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json --runInBand",
    "test:e2e": "pnpm test:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "audit": "pnpm audit",
    "deps:check": "pnpm outdated",
    "test:compile": "node ../tools/compile.mjs tests"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/cqrs": "12.1.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "mongoose": "9.11.2",
    "nestjs-pino": "5.3.1",
    "neverthrow": "8.2.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "dotenv": "18.0.8"
  },
  "files": [
    "dist"
  ]
}
