# syntax=docker/dockerfile:1.27.1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

FROM node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS dependencies
WORKDIR /app
COPY package.json ./
# Use the single integrity-verified root pin; keep package managers out of runtime.
RUN corepack enable && corepack prepare "$(node -p 'require("./package.json").packageManager')" --activate \
    && rm -rf /usr/local/lib/node_modules/npm /opt/yarn* \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
RUN pnpm fetch --store-dir /pnpm/store
COPY auth-server/package.json ./auth-server/
RUN pnpm install --frozen-lockfile --offline --store-dir /pnpm/store

FROM dependencies AS build
COPY auth-server/ ./auth-server/
RUN pnpm --filter auth-server build
RUN pnpm --filter auth-server deploy --prod --frozen-lockfile --offline --store-dir /pnpm/store /deploy

FROM node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS production
ENV NODE_ENV=production
RUN rm -rf /usr/local/lib/node_modules /opt/yarn* \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx
WORKDIR /app
COPY --from=build --chown=node:node /deploy ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/health >/dev/null || exit 1
CMD ["node", "--enable-source-maps", "dist/main.js"]
